# Validation mode: "client" (default) or "server"
# Switch to "server" after deploying the Cloudflare Worker and setting VITE_API_URL
VITE_VALIDATION_MODE=client

# Injected at build time — change for production deployments
VITE_PROGRESS_SECRET=dev-secret-change-me-in-production

# Level encoding key — used by encode-levels.ts at build time
VITE_LEVEL_ENCODE_KEY=dev-level-key-change-me

# Required when VITE_VALIDATION_MODE=server
# VITE_API_URL=https://word-grid-api.your-subdomain.workers.dev
