# Validation mode: "client" (local vite dev) or "server" (Vercel production)
VITE_VALIDATION_MODE=client

# Client — signed localStorage progress (exposed in bundle; set in Vercel Production)
# Generate: openssl rand -hex 32
VITE_PROGRESS_SECRET=dev-secret-change-me-in-production

# Server — unlock tokens (Vercel only, NOT prefixed with VITE_)
# Set the same value in Vercel → Environment Variables as PROGRESS_SECRET
PROGRESS_SECRET=dev-secret-change-me-in-production

# Level encoding key — used at build time to encode levels (Vercel Production)
VITE_LEVEL_ENCODE_KEY=dev-level-key-change-me

# Optional — leave unset on Vercel to use same-origin /api routes
# VITE_API_URL=https://word-grid.vercel.app
